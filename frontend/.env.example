# Sao chép thành .env
# --- API / proxy (cùng máy dev) ---
VITE_API_PORT=3002
# Nếu backend chạy chỗ khác: VITE_API_PROXY_TARGET=http://127.0.0.1:3002

# --- Tailscale / LAN ---
# Dev: npm run dev → Vite lắng nghe mọi interface (host: true). Mở UI:
#   http://<IP-Tailscale-máy-dev>:5100
# API (integrated) mặc định HOST=0.0.0.0 trong code — truy cập:
#   http://<IP-Tailscale-máy-dev>:3002/health  (đổi cổng theo PORT trong .env backend)
# Để trống VITE_API_BASE_URL → fetch dùng /api qua proxy Vite (khuyến nghị).
# Nếu set VITE_API_BASE_URL=http://localhost:3002 nhưng mở UI bằng IP Tailscale, http.ts tự đổi host.
# VITE_DEV_PORT=5100

# --- Build tĩnh / API host tuyệt đối (tùy chọn) ---
# VITE_API_BASE_URL=
