# =============================================================================
# CHỈ biến an toàn cho bundle Vite (mọi giá trị VITE_* được embed vào JS công khai).
# KHÔNG đặt mật khẩu, JWT secret, connection string DB, API key vào đây.
# =============================================================================

# PM2 serve không proxy /api, nên đặt URL API tuyệt đối.
VITE_API_BASE_URL=http://localhost:3002

# Chỉ dùng khi UI và API khác host (HTTPS tách subdomain); vẫn chỉ URL công khai, không secret.
# VITE_API_BASE_URL=https://mes.cadivi.internal

# Cổng proxy dev — không dùng trong build production nếu để trống API_BASE_URL.
# VITE_API_PORT=3002
