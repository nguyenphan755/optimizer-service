DB_HOST=localhost
DB_PORT=5432
DB_NAME=mes_cadivi
DB_USER=postgres
DB_PASSWORD=postgres

# Tuỳ chọn: một connection string (ưu tiên hơn DB_*). Không log giá trị đầy đủ ra console.
# DATABASE_URL=postgresql://cadivi_app:password@localhost:5432/mes_cadivi

# Khớp VITE_API_PORT trong Apptruyvantocdo-main/.env khi dev (proxy Vite → API).
PORT=3002

# Lắng nghe mọi interface (Tailscale/LAN). Chỉ local: HOST=127.0.0.1
# HOST=0.0.0.0

# development: CORS cho phép mọi origin (mặc định NODE_ENV không phải production).
# production: danh sách origin, phân tách bằng dấu phẩy
# NODE_ENV=production
# CORS_ORIGIN=http://localhost:5100,https://your-domain.com

UPLOAD_DIR=./uploads

# --- MES web login (JWT + bcrypt + refresh cookie) — security hardening ---
# Production: JWT_SECRET và JWT_REFRESH_SECRET mỗi cái ≥ 32 ký tự ngẫu nhiên, KHÁC nhau.
JWT_SECRET=replace-with-at-least-32-chars-production-secret
JWT_REFRESH_SECRET=another-32-chars-minimum-different-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Seed admin (chỉ dev): npm run seed:mes-admin
# MES_ADMIN_USERNAME=admin
# MES_ADMIN_PASSWORD=your-strong-password
# MES_ADMIN_DISPLAY_NAME=Administrator

# Import điện trở (tùy chọn): npm run import:resistance
# RESISTANCE_EXCEL_PATH=C:/path/to/cadivi_resistance_weight_data_v1_20260403.xlsx

# Nếu lỗi EADDRINUSE: port đang bị process khác dùng — tắt terminal cũ hoặc đổi PORT,
# hoặc Windows: Get-NetTCPConnection -LocalPort 3002 | Format-Table; Stop-Process -Id <PID>
