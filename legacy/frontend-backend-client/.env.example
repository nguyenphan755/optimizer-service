# Mặc định: Vite đọc PORT từ file .env ở thư mục gốc dự án (cùng cấp package.json)
# và proxy /api → http://localhost:$PORT — không bắt buộc tạo client/.env.
#
# Dev qua Tailscale: chạy `npm run dev` (API) + `npm run client:dev` (Vite mặc định --host),
# mở http://<IP-Tailscale-máy-dev>:5100 — proxy vẫn trỏ API trên máy dev.

# Chỉ thêm dòng dưới khi API chạy khác host/port so với .env gốc:
# VITE_API_PROXY_TARGET=http://127.0.0.1:3002

# Cổng API khi trình duyệt gọi thẳng backend (cùng hostname với trang, khác cổng Vite).
# Dùng khi set VITE_API_URL=http://localhost:... nhưng mở UI bằng IP Tailscale — searchApi tự đổi host.
# VITE_API_PORT=3000

# Gọi thẳng API (bỏ qua proxy). Thường không cần khi dev với Vite + proxy.
# VITE_API_URL=http://localhost:3000

# Cổng Vite (tùy chọn, mặc định 5100)
# VITE_DEV_PORT=5100
